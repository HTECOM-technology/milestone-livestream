# Ubuntu 22 Nginx Gateway on 10.130.1.20
# Role:
# - Forward all user requests to Windows Nginx on 10.2.18.11
# - Windows Nginx serves /hls and /thumbnails, and proxies /api to Python

upstream milestone_windows_nginx {
    server 10.2.18.11:80;
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 100M;

    location / {
        proxy_pass http://milestone_windows_nginx;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
