APP_NAME=Milestone Livestream Backend
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_BASE_URL=http://10.130.1.20

MILESTONE_BASE_URL=http://10.2.18.11:8081
MILESTONE_DOMAIN=VMS-ITS
MILESTONE_USERNAME=administrator
MILESTONE_PASSWORD=promise@123
MILESTONE_VERIFY_SSL=false
MILESTONE_REQUEST_TIMEOUT_SECONDS=20
MILESTONE_STREAM_TIMEOUT_SECONDS=60
MILESTONE_RECONNECT_DELAY_SECONDS=3
MILESTONE_CAMERA_CACHE_TTL_SECONDS=300

HLS_ROOT=C:\hls
THUMBNAIL_ROOT=C:\thumbnails
HLS_PUBLIC_PREFIX=/hls
THUMBNAIL_PUBLIC_PREFIX=/thumbnails

WORKER_PYTHON_EXECUTABLE=python
VIEWER_HEARTBEAT_TTL_SECONDS=90
VIEWER_CLEANUP_INTERVAL_SECONDS=10
THUMBNAIL_REFRESH_INTERVAL_MINUTES=30

FFMPEG_BIN=C:\nginx\ffmpeg.exe

WORKER_TARGET_FPS=2
WORKER_FRAME_INTERVAL_SECONDS=0.5
WORKER_FORCE_THROTTLE=false
HLS_WIDTH=854
HLS_HEIGHT=480
HLS_BITRATE=300k
HLS_MAXRATE=400k
HLS_BUFSIZE=800k
HLS_SEGMENT_SECONDS=1
HLS_LIST_SIZE=5
HLS_DELETE_THRESHOLD=2
